#!/bin/zsh
set -euo pipefail
root="${0:A:h:h}"
node_bin="${CODEX_CUA_NODE:-}"
if [[ -z "$node_bin" ]]; then
  node_bin="$(command -v node || true)"
fi
if [[ -z "$node_bin" ]]; then
  node_bin="${CODEX_COMPUTER_USE_APP:-/Applications/ChatGPT.app}/Contents/Resources/cua_node/bin/node"
fi
if [[ ! -x "$node_bin" ]]; then
  print -u2 "Node.js 24.11+ is missing: $node_bin"
  exit 1
fi
unset NODE_OPTIONS
exec "$node_bin" "$root/src/cli.mjs" "$@"
